{
    "command": [
        "/opt/vep/src/ensembl-vep/vep",
        "--format", "vcf",
        "__OUTPUT_FORMAT_FLAG__",
        "--fasta", "/fasta/ucsc.hg19.fasta",
        "--dir_cache", "/reference/VEP_cache/extracted",
        "--dir_plugins", "/opt/vep/src/ensembl-vep/Plugins",
        "--no_stats",
        "--cache",
        "--offline",
        "--assembly", "GRCh37",
        "--cache_version", "108",
        "--merged",
        "--hgvs",
        "--hgvsg",
        "--symbol",
        "--pick",
        "--canonical",
        "--use_given_ref",
        "--plugin", "dbNSFP,/reference/dbnsfp/dbNSFP5.3.1a_grch37.gz,CADD_phred,REVEL_score,SIFT_score,Polyphen2_HDIV_score,MetaRNN_score,ClinPred_score,AlphaMissense_score,dbNSFP_POPMAX_AF",
        "--custom", "/reference/clinvar/clinvar.vcf.gz,ClinVar,vcf,exact,0,CLNSIG,CLNREVSTAT",
        "-o", "STDOUT"
    ],
    "env": {
        "PERL5LIB": "/opt/vep/src/ensembl-vep/Plugins"
    },
    "vep_json_schema": "Struct{input:String,most_severe_consequence:String,transcript_consequences:Array[Struct{consequence_terms:Array[String],impact:String,gene_symbol:String,hgvsg:String,hgvsc:String,hgvsp:String,transcript_id:String,canonical:Int32,cadd_phred:String,revel_score:String,sift_score:String,polyphen2_hdiv_score:String,metarnn_score:String,clinpred_score:String,alphamissense_score:String,dbnsfp_popmax_af:String}],intergenic_consequences:Array[Struct{consequence_terms:Array[String],impact:String}],custom_annotations:Struct{ClinVar:Array[Struct{allele:String,fields:Struct{CLNSIG:String,CLNREVSTAT:String}}]}}}"
}
